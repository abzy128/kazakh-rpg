# Meta Model API key (game backend). Use a different key for Muse Code.
META_AI_API_KEY=
# Soniox key for NPC voices (TTS) and optional Kazakh STT. Without it, the browser's speech synthesis is used.
SONIOX_API_KEY=
# Who transcribes Kazakh speech: meta (Muse Voice Transcribe, default) or soniox.
KK_STT_PROVIDER=meta
# Set to 1 to pause the public demo.
DEMO_PAUSED=
# Game-master turns per day across all players.
DAILY_GM_CAP=4000
